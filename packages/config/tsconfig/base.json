{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // node16 (not the older "node") is what teaches TypeScript to read the
    // `exports` map in our workspace packages — it is why `@repo/models/user`
    // resolves. Packages here have no `"type": "module"`, so this compiles to
    // CommonJS, which is what Vercel's Node runtime wants.
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "exclude": ["node_modules", "dist", ".next"]
}
