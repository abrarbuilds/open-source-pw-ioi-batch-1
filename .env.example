# Copy this file to `.env` at the repo root and fill it in.
#   cp .env.example .env
#
# The four apps read from this one file in local development. On Vercel, each
# project gets its own environment variables — see docs/deployment.md.
#
# APPEND-ONLY: add your team's variables under a new `# --- team NN ---` header
# at the bottom. Do not reorder or reformat other teams' lines.

# --- team 01: platform ---------------------------------------------------
NODE_ENV=development

# MongoDB Atlas connection string. Use the `tracker_dev` database locally —
# never point this at `tracker_prod`, the seed script wipes what it connects to.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tracker_dev?retryWrites=true&w=majority

# Where each frontend finds its API. The student app talks to api-student, the
# admin app talks to api-admin — never the other way round.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Comma-separated list of origins the APIs accept browser requests from.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- team 03: auth -------------------------------------------------------
# Generate your own: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# These two must be different from each other.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

# --- team 04: materials --------------------------------------------------
# https://console.cloudinary.com — Settings → API Keys.
# The secret must only ever be set on the APIs, never on a Next.js app: anything
# without the NEXT_PUBLIC_ prefix stays server-side, but a Cloudinary secret in a
# frontend project is one careless `NEXT_PUBLIC_` away from being public.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- team 13: ai assistant -----------------------------------------------
# https://console.anthropic.com — set on api-student only.
ANTHROPIC_API_KEY=
